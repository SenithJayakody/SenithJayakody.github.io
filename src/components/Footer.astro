---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<footer class="site-footer">
  <div class="footer-content">
    <p>&copy; 2026 {SITE_TITLE}</p>
    <nav aria-label="Social links">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer{border-top:1px solid var(--color-border);margin-top:auto;padding:1.5rem 1rem}
  .footer-content{align-items:center;display:flex;gap:1.5rem;justify-content:space-between;margin:0 auto;max-width:var(--max-width)}
  .footer-content p{font-size:.85rem;margin:0}
  .footer-content nav{display:flex;flex-wrap:wrap;gap:.9rem}
  .footer-content a{color:var(--color-text-muted);font-size:.82rem;text-decoration:none}
  .footer-content a:hover,.footer-content a:focus-visible{color:var(--color-accent);text-decoration:underline;text-underline-offset:.18em}
  @media(max-width:600px){.footer-content{align-items:flex-start;flex-direction:column;gap:.75rem}.footer-content nav{gap:.65rem 1rem}}
</style>
