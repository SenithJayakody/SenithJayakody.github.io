---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`About | ${SITE_TITLE}`} description="Education, experience, skills, and achievements of Senith Jayakody." />
  <style>
    .intro{max-width:760px;padding:3rem 0 2rem}.intro h1{font-size:clamp(3rem,7vw,5rem);letter-spacing:-.04em}.lead{font-size:1.2rem;line-height:1.8}
    .layout{display:grid;grid-template-columns:1.6fr .8fr;gap:4rem}.item{padding:1.3rem 0;border-bottom:1px solid var(--color-border)}.item h3{margin:.2rem 0;font-size:1.2rem}.date{font-size:.78rem;color:var(--color-accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.item p{margin:.4rem 0;font-size:.95rem}
    .tags{display:flex;flex-wrap:wrap;gap:.5rem}.tag{border:1px solid var(--color-border);border-radius:999px;padding:.3rem .7rem;font-size:.82rem;color:var(--color-text-muted)}
    @media(max-width:760px){.layout{grid-template-columns:1fr;gap:1rem}}
  </style>
</head>
<body>
<Header />
<main>
  <section class="intro">
    <span class="date">About</span>
    <h1>Research grounded in real-world sensing.</h1>
    <p class="lead">I am a Research Assistant at the Multidisciplinary AI Research Centre, University of Peradeniya. My work connects sensing hardware, signal processing, and predictive modelling to create robust and interpretable systems for healthcare, agriculture, and environmental monitoring.</p>
  </section>
  <div class="layout">
    <div>
      <h2>Experience</h2>
      <article class="item"><span class="date">2025 — Present</span><h3>Research Assistant · MARC, University of Peradeniya</h3><p>Leading preterm-birth prediction research, developing biomedical acquisition hardware, supervising junior researchers, and advancing a field-deployable multispectral imaging platform.</p></article>
      <article class="item"><span class="date">2023 — 2025</span><h3>Undergraduate Researcher · MARC</h3><p>Developed MSI models for soil moisture, soil texture, and Microcystis toxicity while improving lighting, electronics, calibration, and Raspberry Pi integration.</p></article>
      <article class="item"><span class="date">Jul — Oct 2024</span><h3>R&D Intern · Swartup Pvt Ltd</h3><p>Migrated embedded systems from ESP32 FreeRTOS to NRF5340 Zephyr and designed modular LoRa- and GSM-capable hardware.</p></article>
      <article class="item"><span class="date">Jul — Oct 2023</span><h3>R&D Intern · Sri Lanka Telecom Digital Lab</h3><p>Developed IoT environmental monitoring systems with ESP32, MQTT, and integrated sensors.</p></article>

      <h2>Education</h2>
      <article class="item"><span class="date">2019 — 2025</span><h3>B.Sc. Eng. (Hons.) · University of Peradeniya</h3><p>Electrical and Electronic Engineering · GPA 3.85</p></article>
    </div>
    <aside>
      <h2>Recognition</h2>
      <article class="item"><span class="date">2025</span><h3>Second Runner-Up, Manamperi Award</h3><p>Best Undergraduate Project in Sri Lanka for multispectral imaging research.</p></article>
      <article class="item"><span class="date">2024</span><h3>Silver Award, Sahasak Nimavum</h3><p>Engineering category, Inventions and Innovations Competition.</p></article>
      <article class="item"><span class="date">2023</span><h3>2nd Place, ACES Hackathon</h3></article>

      <h2>Technical toolkit</h2>
      <div class="tags">
        {['Python','C/C++','MATLAB','PyTorch','TensorFlow','scikit-learn','OpenCV','Signal processing','MFCC','Raspberry Pi','ESP32','NRF5340','Linux','Git','MQTT','Circuit design'].map(skill => <span class="tag">{skill}</span>)}
      </div>
    </aside>
  </div>
</main>
<Footer />
</body>
</html>
