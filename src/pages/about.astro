---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`About | ${SITE_TITLE}`} description="AI Research and Development Engineer working in signal processing, machine learning, generative models, and computational imaging." />
  <style>
    .intro{max-width:820px;padding:3rem 0 2rem}.intro h1{font-size:clamp(3rem,7vw,5rem);letter-spacing:-.04em}.lead{font-size:1.2rem;line-height:1.8}
    .layout{display:grid;grid-template-columns:1.6fr .8fr;gap:4rem}.item{padding:1.3rem 0;border-bottom:1px solid var(--color-border)}.item h3{margin:.2rem 0;font-size:1.2rem}.date{font-size:.78rem;color:var(--color-accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.item p{margin:.4rem 0;font-size:.95rem}
    .organization-link{color:inherit;text-decoration:none}.organization-link:hover,.organization-link:focus-visible{color:var(--color-accent);text-decoration:underline;text-underline-offset:.18em}.external-icon{display:inline-block;font-size:.72em;margin-left:.18em;vertical-align:.12em}
    .skill-group{margin:1.1rem 0}.skill-group h3{font-size:.9rem;margin:0 0 .55rem}.tags{display:flex;flex-wrap:wrap;gap:.5rem}.tag{border:1px solid var(--color-border);border-radius:999px;padding:.3rem .7rem;font-size:.82rem;color:var(--color-text-muted)}
    .qualifications{margin-top:1rem}.qualification{padding:1rem 0}.qualification+.qualification{border-top:1px solid var(--color-border)}.qualification h4{color:var(--color-text-main);font-size:1rem;margin:0 0 .35rem}.qualification p{margin:.25rem 0}.qualification a{display:inline-block;font-size:.88rem;margin-top:.4rem}.achievement{font-weight:700}.document-links{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
    .degree-field{color:var(--color-text-main);font-size:1.05rem;font-weight:700}.supporting{color:var(--color-text-muted);font-size:.85rem!important}
    @media(max-width:760px){.intro h1{font-size:clamp(2.25rem,11vw,3rem)}.layout{grid-template-columns:1fr;gap:1rem}}
  </style>
</head>
<body>
<Header />
<main>
  <section class="intro">
    <span class="date">About</span>
    <h1>Engineering Foundations, Interdisciplinary Research</h1>
    <p class="lead">I am an Electrical and Electronic Engineering graduate from the University of Peradeniya, Sri Lanka, where I earned my B.Sc. Eng. (Hons.) with First Class Honours, achieving a GPA of 3.85/4.00 and ranking 6th among 115 students. I currently work as an AI Research and Development Engineer at FARBE Technologies (Pvt) Ltd.</p>
    <p class="lead">My research spans signal processing, machine learning, statistical learning, generative modeling, and computational imaging. My experience includes both methodological investigations, such as the statistical properties of diffusion models and implicit neural representations, and application-driven research in biomedical signal analysis, image processing, and multispectral imaging.</p>
    <p class="lead">I am interested in developing theoretically grounded computational methods, understanding their capabilities and limitations, and applying them to challenging problems across scientific and engineering disciplines.</p>
  </section>
  <div class="layout">
    <div>
      <h2>Experience</h2>
      <article class="item"><span class="date">August 2026 — Present</span><h3>AI Research and Development Engineer · <a class="organization-link" href="https://farbe.lk/" target="_blank" rel="noopener noreferrer" aria-label="FARBE Technologies (Pvt) Ltd. (opens in a new tab)">FARBE Technologies (Pvt) Ltd.<span class="external-icon" aria-hidden="true">↗</span></a></h3><p>Developing and evaluating AI-based signal and image processing methods for research and industrial applications, integrating machine-learning approaches with practical engineering requirements.</p></article>
      <article class="item"><span class="date">August 2025 — July 2026</span><h3>Research Assistant · <a class="organization-link" href="https://marcuop.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Multidisciplinary AI Research Centre (MARC), University of Peradeniya (opens in a new tab)">Multidisciplinary AI Research Centre (MARC), University of Peradeniya<span class="external-icon" aria-hidden="true">↗</span></a></h3><p>Investigated interpretable signal-processing and machine-learning methods for biomedical signals and multispectral imaging, developing feature-extraction and evaluation pipelines while contributing to experimental research and manuscript preparation.</p><p>The resulting EHG study, involving empirical mode decomposition and interpretable machine learning for preterm birth classification, is currently under review at PLOS ONE.</p></article>
      <article class="item"><span class="date">2023 — 2025</span><h3>Undergraduate Researcher · University of Peradeniya</h3><p>Contributed to the development of a 13-band reflectance multispectral imaging system and machine-learning methods for soil characterization, addressing the need for non-destructive estimation of soil moisture and grain-size composition. This collaborative research contributed to peer-reviewed journal and conference publications.</p></article>
      <article class="item"><span class="date">July — October 2024</span><h3>R&amp;D Intern · <a class="organization-link" href="https://swartup.com/" target="_blank" rel="noopener noreferrer" aria-label="Swartup Pvt. Ltd. (opens in a new tab)">Swartup Pvt. Ltd.<span class="external-icon" aria-hidden="true">↗</span></a></h3><p>Implemented embedded-system migration from ESP32 with FreeRTOS to the nRF5340 with Zephyr, and developed modular hardware supporting LoRa and GSM communication.</p></article>
      <article class="item"><span class="date">July — October 2023</span><h3>R&amp;D Intern · <a class="organization-link" href="https://embryo.slt.lk/" target="_blank" rel="noopener noreferrer" aria-label="SLT Digital Lab, Sri Lanka Telecom PLC (opens in a new tab)">SLT Digital Lab, Sri Lanka Telecom PLC<span class="external-icon" aria-hidden="true">↗</span></a></h3><p>Developed an ESP32-based environmental monitoring system using MQTT and Firebase, integrating sensors for data acquisition and remote monitoring.</p></article>

      <h2>Education</h2>
      <article class="item">
        <span class="date">2021 — 2025</span>
        <h3>Bachelor of Science in Engineering (Honours)</h3>
        <p class="degree-field">Electrical and Electronic Engineering</p>
        <p>University of Peradeniya, Sri Lanka</p>
        <p>First Class Honours · GPA: 3.85/4.00 · Class Rank: 6/115</p>
        <div class="document-links"><a class="btn btn-outline" href="/documents/Academic-Transcript.pdf" target="_blank">View academic transcript</a></div>
      </article>
      <article class="item">
        <span class="date">Secondary Education · 2005–2019</span>
        <h3>Trinity College, Kandy</h3>
        <div class="qualifications">
          <section class="qualification">
            <h4>G.C.E. Advanced Level — 2019</h4>
            <p>National University Entrance Examination · Physical Science Stream</p>
            <p>Combined Mathematics (A) · Physics (A) · Chemistry (A)</p>
            <p class="achievement">Top 4% nationwide in the Physical Science stream</p>
            <p class="supporting">Z-score: 2.1582</p>
            <a href="/documents/gce-al-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </section>
          <section class="qualification">
            <h4>G.C.E. Ordinary Level — 2016</h4>
            <p>9 A grades</p>
            <a href="/documents/gce-ol-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </section>
        </div>
      </article>
    </div>
    <aside>
      <h2>Recognition &amp; Awards</h2>
      <article class="item"><span class="date">2025</span><h3>Second Runner-Up — Manamperi Award</h3><p>Recognition in the Best Undergraduate Project in Sri Lanka competition for multispectral imaging research.</p></article>
      <article class="item"><span class="date">2024</span><h3>Silver Award — Sahasak Nimavum</h3><p>Engineering Category, National Inventions and Innovations Competition.</p><a href="https://www.facebook.com/share/p/1CgKpRyYwi/" target="_blank" rel="noopener noreferrer">View Award Post ↗</a></article>
      <article class="item"><span class="date">2024</span><h3>Top 10 Finalist — Predicta v1.0</h3><p>IEEE Student Branch, University of Peradeniya.</p></article>
      <article class="item"><span class="date">2023</span><h3>Finalist — IEEE Electronic Design Competition</h3><p>IEEE Sri Lanka Section.</p></article>
      <article class="item"><span class="date">2023</span><h3>Second Place — ACES Hackathon</h3><p>Healthcare Category, University of Peradeniya.</p></article>
      <article class="item"><span class="date">2022</span><h3>Fourth Place — IESL RoboGames</h3><p>University Category.</p></article>

      <h2>Technical toolkit</h2>
      {[
        ['Programming', ['Python', 'MATLAB', 'C/C++', 'Assembly Language']],
        ['Machine Learning & Deep Learning', ['PyTorch', 'TensorFlow', 'scikit-learn', 'generative modeling', 'model evaluation']],
        ['Signal & Image Processing', ['Time-frequency analysis', 'spectral analysis', 'EMD', 'wavelets', 'OpenCV', 'SciPy']],
        ['Embedded Systems & Sensing', ['Raspberry Pi', 'ESP32', 'nRF5340', 'Zephyr', 'FreeRTOS', 'sensor integration', 'circuit design']],
        ['Research Tools', ['Linux', 'Git', 'LaTeX', 'Altium Designer', 'EasyEDA']],
      ].map(([group, skills]) => (
        <section class="skill-group">
          <h3>{group}</h3>
          <div class="tags">{skills.map((skill) => <span class="tag">{skill}</span>)}</div>
        </section>
      ))}
    </aside>
  </div>
</main>
<Footer />
</body>
</html>
