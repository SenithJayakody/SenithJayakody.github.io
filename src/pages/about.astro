---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`About | ${SITE_TITLE}`} description="Education, academic records, and contact information for Senith Jayakody." />
  <style>
    main{max-width:900px}
    .item{padding:1rem 0;border-bottom:1px solid var(--color-border)}
    .item h3,.item p{margin:.35rem 0}
    .item h3{font-size:1.2rem}
    .date,.supporting{color:var(--color-text-muted);font-size:.875rem}
    .record{display:grid;grid-template-columns:3rem minmax(0,1fr);gap:.85rem}
    .org-logo{display:block;width:3rem;height:3rem;object-fit:contain;background:#fff;border-radius:8px;padding:.2rem}
    .qualification{margin-top:.85rem;padding-top:.75rem;border-top:1px solid var(--color-border)}
    .qualification h4{margin:0}
    .achievement,.degree-field{font-weight:700}
    .document-links{margin-top:.75rem}
    .contact{margin:0}
    .contact div{display:flex;flex-wrap:wrap;column-gap:1rem;padding:.35rem 0}
    .contact dt{min-width:7rem}
    .contact dd{margin:0;overflow-wrap:anywhere}
  </style>
</head>
<body>
<Header />
<main>
  <h1>Education &amp; Contact</h1>
      <h2>Education</h2>
      <article class="item record"><img class="org-logo" src={url('/images/organizations/peradeniya.webp')} alt="University of Peradeniya logo" width="48" height="48" /><div>
        <span class="date">2021 — 2025</span>
        <h3><a href="https://www.pdn.ac.lk/">University of Peradeniya, Sri Lanka</a></h3>
        <p>Bachelor of Science in Engineering (Honours)</p>
        <p class="degree-field">Electrical and Electronic Engineering</p>
        <p>First Class Honours · GPA: 3.85/4.00 · Class Rank: 6/115</p>
        <div class="document-links"><a class="btn btn-outline" href="/documents/Academic-Transcript.pdf" target="_blank">View academic transcript</a></div>
      </div></article>
      <article class="item record"><span aria-hidden="true"></span><div>
        <span class="date">Secondary Education · 2005–2019</span>
        <h3><a href="https://trinitycollege.lk/">Trinity College Kandy, Sri Lanka</a></h3>
        <div class="qualifications">
          <section class="qualification">
            <h4>G.C.E. Advanced Level — 2019</h4>
            <p>National University Entrance Examination · Physical Science Stream</p>
            <p>Combined Mathematics (A) · Physics (A) · Chemistry (A)</p>
            <p class="achievement">Top 3% nationwide in the Physical Science stream</p>
            <p class="supporting">Z-score: 2.1582</p>
            <a href="/documents/gce-al-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </section>
          <section class="qualification">
            <h4>G.C.E. Ordinary Level — 2016</h4>
            <p>9 A grades</p>
            <a href="/documents/gce-ol-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </section>
        </div>
      </div></article>
  <h2>Contact</h2>
  <dl class="contact">
    {[
      ['Personal', 'senithjayakody2000@gmail.com'],
      ['University', 'senith@eng.pdn.ac.lk'],
      ['Professional', 'senith@farbetechnologies.ai'],
    ].map(([label, email]) => <div><dt>{label}</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>)}
  </dl>
</main>
<Footer />
</body>
</html>
