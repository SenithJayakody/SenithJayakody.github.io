---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`About | ${SITE_TITLE}`} description="AI Research and Development Engineer working in signal processing, machine learning, generative models, and computational imaging." />
  <style>
    .intro{max-width:760px;padding:3rem 0 2rem}.intro h1{font-size:clamp(3rem,7vw,5rem);letter-spacing:-.04em}.lead{font-size:1.2rem;line-height:1.8}
    .layout{display:grid;grid-template-columns:1.6fr .8fr;gap:4rem}.item{padding:1.3rem 0;border-bottom:1px solid var(--color-border)}.item h3{margin:.2rem 0;font-size:1.2rem}.date{font-size:.78rem;color:var(--color-accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.item p{margin:.4rem 0;font-size:.95rem}
    .tags{display:flex;flex-wrap:wrap;gap:.5rem}.tag{border:1px solid var(--color-border);border-radius:999px;padding:.3rem .7rem;font-size:.82rem;color:var(--color-text-muted)}
    .results{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:1rem}.result-card{border:1px solid var(--color-border);border-radius:12px;padding:1rem}.result-card strong{display:block;color:var(--color-text-main)}.result-card p{margin:.35rem 0;font-size:.9rem}.document-links{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
    @media(max-width:760px){.layout{grid-template-columns:1fr;gap:1rem}.results{grid-template-columns:1fr}}
  </style>
</head>
<body>
<Header />
<main>
  <section class="intro">
    <span class="date">About</span>
    <h1>Research across signals, images, and learning.</h1>
    <p class="lead">I am an AI Research and Development Engineer at FARBE Technologies (Pvt) Ltd., Sri Lanka, and a graduate of Electrical and Electronic Engineering from the University of Peradeniya, where I obtained First Class Honours.</p>
    <p class="lead">My research spans signal processing, machine learning, statistical learning, and computational imaging. I have worked on problems ranging from theoretical investigations of diffusion models and implicit neural representations to biomedical signal analysis, multispectral imaging, and embedded sensing systems.</p>
    <p class="lead">I am interested in developing a deeper understanding of computational methods, investigating their capabilities and limitations, and applying them to challenging problems across scientific and engineering disciplines.</p>
  </section>
  <div class="layout">
    <div>
      <h2>Experience</h2>
      <article class="item"><span class="date">Aug 2026 — Present</span><h3>AI Research and Development Engineer · FARBE Technologies (Pvt) Ltd.</h3><p>Work on AI-based signal and image processing methods for research and industrial applications.</p></article>
      <article class="item"><span class="date">Aug 2025 — Jul 2026</span><h3>Research Assistant · MARC, University of Peradeniya</h3><p>Worked on biomedical signal analysis and multispectral imaging, including computational methods, experimental evaluation, and sensing-system development.</p></article>
      <article class="item"><span class="date">2023 — 2025</span><h3>Undergraduate Researcher · University of Peradeniya</h3><p>Investigated multispectral imaging and machine-learning methods for soil moisture, soil texture, and environmental sensing, alongside imaging-system development and evaluation.</p></article>
      <article class="item"><span class="date">Jul — Oct 2024</span><h3>R&D Intern · Swartup Pvt Ltd</h3><p>Migrated embedded systems from ESP32 FreeRTOS to NRF5340 Zephyr and designed modular LoRa- and GSM-capable hardware.</p></article>
      <article class="item"><span class="date">Jul — Oct 2023</span><h3>R&D Intern · Sri Lanka Telecom Digital Lab</h3><p>Developed IoT environmental monitoring systems with ESP32, MQTT, and integrated sensors.</p></article>

      <h2>Education</h2>
      <article class="item">
        <span class="date">2019 — 2025</span>
        <h3>B.Sc. Eng. (Hons.) · University of Peradeniya</h3>
        <p>Electrical and Electronic Engineering · First Class Honours · GPA 3.85 · Degree effective 19 August 2025.</p>
        <div class="document-links"><a class="btn btn-outline" href="/documents/Academic-Transcript.pdf" target="_blank">View academic transcript</a></div>
      </article>
      <article class="item">
        <span class="date">2005 — 2019</span>
        <h3>Trinity College Kandy</h3>
        <p>Primary and secondary education, completing the G.C.E. Ordinary Level and Advanced Level examinations.</p>
        <div class="results">
          <div class="result-card">
            <strong>G.C.E. Advanced Level · 2019</strong>
            <p>Physical Science stream: Combined Mathematics — A, Physics — A, Chemistry — A.</p>
            <p>General English — A · Common General Test — 74 · Z-score — 2.1582.</p>
            <a href="/documents/gce-al-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </div>
          <div class="result-card">
            <strong>G.C.E. Ordinary Level · 2016</strong>
            <p>Nine A grades, including Mathematics, Science, English, History, Buddhism, Sinhala, Music, Civic Education, and Health & Physical Education.</p>
            <a href="/documents/gce-ol-result-sheet.pdf" target="_blank">View result sheet ↗</a>
          </div>
        </div>
      </article>
    </div>
    <aside>
      <h2>Recognition</h2>
      <article class="item"><span class="date">2025</span><h3>Second Runner-Up, Manamperi Award</h3><p>Best Undergraduate Project in Sri Lanka for multispectral imaging research.</p></article>
      <article class="item"><span class="date">2024</span><h3>Silver Award, Sahasak Nimavum</h3><p>Engineering category, Inventions and Innovations Competition.</p></article>
      <article class="item"><span class="date">2023</span><h3>2nd Place, ACES Hackathon</h3></article>

      <h2>Technical toolkit</h2>
      <div class="tags">
        {['Python','C/C++','MATLAB','PyTorch','TensorFlow','scikit-learn','OpenCV','Signal processing','MFCC','Raspberry Pi','ESP32','NRF5340','Linux','Git','MQTT','Circuit design'].map(skill => <span class="tag">{skill}</span>)}
      </div>
    </aside>
  </div>
</main>
<Footer />
</body>
</html>
