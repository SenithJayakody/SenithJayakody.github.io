---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`Activities | ${SITE_TITLE}`} description="Workshops, exhibitions, outreach, and academic service by Senith Jayakody." />
  <style>
    .hero{padding:3.5rem 0 2.5rem;max-width:760px}.eyebrow{color:var(--color-accent);font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.hero h1{font-size:clamp(3rem,7vw,5rem);letter-spacing:-.045em;margin:.6rem 0 1rem}.hero p{font-size:1.15rem;line-height:1.75}
    .activity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin:1.5rem 0 4rem}.activity{border:1px solid var(--color-border);border-radius:16px;padding:1.5rem;background:var(--color-bg-offset);display:flex;flex-direction:column}.activity .year{font-size:.75rem;font-weight:700;color:var(--color-accent);letter-spacing:.1em;text-transform:uppercase}.activity h3{font-size:1.25rem;margin:.65rem 0}.activity p{font-size:.94rem;margin:0;flex:1}.type{display:inline-block;margin-top:1.2rem;font-size:.75rem;color:var(--color-text-muted);border-top:1px solid var(--color-border);padding-top:.8rem}
    .service{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:4rem}.service article{padding:1.2rem 0;border-bottom:1px solid var(--color-border)}.service h3{font-size:1.1rem;margin:.25rem 0}.service p{font-size:.9rem;margin:0}
    @media(max-width:760px){.activity-grid,.service{grid-template-columns:1fr}}
  </style>
</head>
<body>
<Header />
<main>
  <section class="hero">
    <span class="eyebrow">Knowledge sharing & outreach</span>
    <h1>Workshops & exhibitions</h1>
    <p>Alongside research, I enjoy translating engineering and AI into practical demonstrations and accessible learning experiences for students and wider communities.</p>
  </section>

  <section>
    <div class="activity-grid">
      <article class="activity">
        <span class="year">2025</span>
        <h3>Diamond Jubilee AI Workshop</h3>
        <p>Conducted sessions and interactive demonstrations on artificial intelligence applications and embedded systems for pre-engineering students.</p>
        <span class="type">Workshop · Teaching & demonstrations</span>
      </article>
      <article class="activity">
        <span class="year">2025</span>
        <h3>AI Symposium, Trinity College Kandy</h3>
        <p>Participated in panel discussions and student sessions showcasing real-world AI use cases and pathways into engineering research.</p>
        <span class="type">Symposium · Panel & student engagement</span>
      </article>
      <article class="activity">
        <span class="year">2025</span>
        <h3>DreamEx 2025</h3>
        <p>Represented university research at Hatharaliyadda National School and demonstrated multispectral imaging applications in agriculture and healthcare.</p>
        <span class="type">Educational exhibition · Research demonstration</span>
      </article>
    </div>
  </section>

  <section>
    <span class="eyebrow">Service</span>
    <h2>Student & professional engagement</h2>
    <div class="service">
      <article><span class="year">2021 — 2022</span><h3>IEEE RAS Student Chapter</h3><p>Logistics team member supporting robotics competitions and technical workshops for undergraduates.</p></article>
      <article><span class="year">2022 — 2023</span><h3>IET on Campus</h3><p>Volunteer supporting university outreach, technical sessions, and student engagement initiatives.</p></article>
    </div>
  </section>
</main>
<Footer />
</body>
</html>
