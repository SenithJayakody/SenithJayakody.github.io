---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={`Experience | ${SITE_TITLE}`} description="Research and professional experience, awards, and professional memberships." />
  <style>
    main{max-width:900px}
    .item{padding:1rem 0;border-bottom:1px solid var(--color-border)}
    .item h3,.item p{margin:.35rem 0}
    .item h3{font-size:1.2rem}
    .date,.supporting{color:var(--color-text-muted);font-size:.875rem}
    .record{display:grid;grid-template-columns:var(--logo-size) minmax(0,1fr);gap:.85rem}
    .org-logo{display:block;width:var(--logo-size);height:var(--logo-size);object-fit:contain;background:#fff;border-radius:8px;padding:.2rem}
    .qualification{margin-top:.85rem;padding-top:.75rem;border-top:1px solid var(--color-border)}
    .qualification h4{margin:0}
    .achievement,.degree-field{font-weight:700}
    .document-links{margin-top:.75rem}
    .contact{margin:0}
    .contact div{display:flex;flex-wrap:wrap;column-gap:1rem;padding:.35rem 0}
    .contact dt{min-width:7rem}
    .contact dd{margin:0;overflow-wrap:anywhere}
    .record{--logo-size:84px}
    @media(max-width:600px){.record{--logo-size:64px}}
    .farbe{width:min(76px,var(--logo-size));height:min(76px,var(--logo-size))}
    .record-wide{--logo-size:190px}
    .wide{height:auto}
    .membership{--logo-size:72px;align-items:center}
    .membership p{margin:0}
    .iesl{height:auto}
    @media(max-width:600px){.record-wide{grid-template-columns:minmax(0,1fr);--logo-size:170px}.membership{--logo-size:60px}}
  </style>
</head>
<body>
<Header />
<main>
  <h1>Experience</h1>
  <p>Research and professional experience in machine learning, signal processing, computational imaging, and embedded systems.</p>
      <h2>Work and Research Experience</h2>
      <article class="item record"><img class="org-logo farbe" src={url('/images/organizations/farbe.webp')} alt="FARBE Technologies logo" width="76" height="76" /><div><h3>AI Research and Development Engineer</h3><p><a class="organization-link" href="https://farbetechnologies.ai/" target="_blank" rel="noopener noreferrer" aria-label="FARBE Technologies (Pvt) Ltd. (opens in a new tab)">FARBE Technologies (Pvt) Ltd.<span class="external-icon" aria-hidden="true">↗</span></a></p><span class="date">August 2026 — Present</span><p>Developing and evaluating AI-based signal and image processing methods for research and industrial applications, integrating machine-learning approaches with practical engineering requirements.</p></div></article>
      <article class="item record">
        <img class="org-logo" src={url('/images/organizations/marc.webp')} alt="MARC logo" width="84" height="84" />
        <div>
          <h3><a class="organization-link" href="https://pdnmarc.github.io/" target="_blank" rel="noopener noreferrer">Multidisciplinary AI Research Centre (MARC)</a></h3>
          <p>University of Peradeniya</p>
          <p class="date">Research involvement · June 2023 — Present</p>
          <ul>
            <li><strong>Volunteer Researcher</strong> · August 2026 — Present</li>
            <li><strong>Research Assistant</strong> · August 2025 — July 2026</li>
            <li><strong>Volunteer Researcher</strong> · June 2023 — July 2025</li>
          </ul>
          <p>Conducted interdisciplinary research in signal processing, machine learning, computational imaging, and intelligent sensing, contributing to experimental design, data analysis, model evaluation, and research publications. Also supported junior researchers in experimental workflows and manuscript preparation.</p>
          <p>Developed feature-extraction and evaluation pipelines for biomedical signals and multispectral imaging. The resulting EHG study used empirical mode decomposition and interpretable machine learning for preterm birth classification and is under review at PLOS ONE.</p>
        </div>
      </article>
      <article class="item record"><img class="org-logo" src={url('/images/organizations/swartup.webp')} alt="Swartup logo" width="84" height="84" /><div><h3>Research and Development Intern</h3><p><a class="organization-link" href="https://swartup.com/" target="_blank" rel="noopener noreferrer" aria-label="Swartup Pvt. Ltd. (opens in a new tab)">Swartup Pvt. Ltd.<span class="external-icon" aria-hidden="true">↗</span></a></p><span class="date">July 2024 — October 2024</span><p>Implemented embedded-system migration from ESP32 with FreeRTOS to the nRF5340 with Zephyr, and developed modular hardware supporting LoRa and GSM communication.</p></div></article>
      <article class="item record record-wide"><img class="org-logo wide" src={url('/images/organizations/slt-digital-lab.webp')} alt="SLT-MOBITEL The Embryo Innovation Centre logo" width="190" height="51" /><div><h3>Research and Development Intern</h3><p><a class="organization-link" href="https://embryo.slt.lk/" target="_blank" rel="noopener noreferrer" aria-label="SLT Digital Lab, Sri Lanka Telecom PLC (opens in a new tab)">SLT Digital Lab, Sri Lanka Telecom PLC<span class="external-icon" aria-hidden="true">↗</span></a></p><span class="date">July 2023 — October 2023</span><p>Developed an ESP32-based environmental monitoring system using MQTT and Firebase, integrating sensors for data acquisition and remote monitoring.</p></div></article>

      <h2>Awards &amp; Recognition</h2>
      <article class="item"><span class="date">2025</span><h3>Second Runner-Up — Manamperi Award</h3><p>Recognition in the Best Undergraduate Project in Sri Lanka competition for multispectral imaging research.</p></article>
      <article class="item"><span class="date">2024</span><h3>Silver Award — Sahasak Nimavum</h3><p>Engineering Category, National Inventions and Innovations Competition.</p><a href="https://www.facebook.com/share/p/1CgKpRyYwi/" target="_blank" rel="noopener noreferrer">View Award Post ↗</a></article>
      <article class="item"><span class="date">2024</span><h3>Top 10 Finalist — Predicta v1.0</h3><p>IEEE Student Branch, University of Peradeniya.</p></article>
      <article class="item"><span class="date">2023</span><h3>Finalist — IEEE Electronic Design Competition</h3><p>IEEE Sri Lanka Section.</p></article>
      <article class="item"><span class="date">2023</span><h3>Second Place — ACES Hackathon</h3><p>Healthcare Category, University of Peradeniya.</p></article>
      <article class="item"><span class="date">2022</span><h3>Fourth Place — IESL RoboGames</h3><p>University Category.</p></article>

  <h2>Professional Memberships</h2>
  <div class="record membership"><img class="org-logo iesl" src={url('/images/organizations/iesl.webp')} alt="Institution of Engineers, Sri Lanka logo" width="72" height="89" /><p>Associate Member — <a href="https://www.iesl.lk/" target="_blank" rel="noopener noreferrer">Institution of Engineers, Sri Lanka (IESL)</a></p></div>
</main>
<Footer />
</body>
</html>
