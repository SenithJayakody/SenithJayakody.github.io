---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';
import { url } from '../utils/paths';
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
    .hero{display:grid;grid-template-columns:1.5fr .8fr;gap:4rem;align-items:center;padding:5rem 0 4rem}
    .eyebrow{color:var(--color-accent);font-size:.78rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
    .hero h1{font-size:clamp(3rem,8vw,5.5rem);letter-spacing:-.055em;line-height:.94;margin:.7rem 0 1.25rem}
    .role{font-family:var(--font-serif);font-size:1.35rem;color:var(--color-text-main);margin:0 0 1.25rem}
    .intro{font-size:1.08rem;max-width:650px;line-height:1.75}
    .actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}
    .portrait{aspect-ratio:1;border-radius:28px;background:linear-gradient(145deg,#0b3954,#087e8b);display:grid;place-items:center;color:#fff;font-family:var(--font-serif);font-size:5.5rem;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
    .portrait:after{content:"";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.35);border-radius:20px}
    .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-border);border:1px solid var(--color-border);border-radius:16px;overflow:hidden;margin:1rem 0 4rem}
    .fact{background:var(--color-bg);padding:1.5rem}.fact strong{display:block;font-family:var(--font-serif);font-size:1.25rem}.fact span{font-size:.85rem;color:var(--color-text-muted)}
    .section{padding:2rem 0 3rem}.section h2{margin-top:0}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
    .card{border:1px solid var(--color-border);border-radius:14px;padding:1.4rem;background:var(--color-bg-offset)}
    .card small{color:var(--color-accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.card h3{font-size:1.15rem;margin:.6rem 0}.card p{font-size:.92rem;margin:0}
    .connect{display:flex;gap:1rem;flex-wrap:wrap}
    @media(max-width:760px){.hero{grid-template-columns:1fr;padding:3rem 0}.portrait{max-width:300px}.facts,.cards{grid-template-columns:1fr}.hero h1{font-size:3.5rem}}
  </style>
</head>
<body>
  <Header />
  <main>
    <section class="hero">
      <div>
        <span class="eyebrow">Researcher · Engineer · Builder</span>
        <h1>Senith<br/>Jayakody</h1>
        <p class="role">Research Assistant at MARC, University of Peradeniya</p>
        <p class="intro">I build intelligent sensing systems at the intersection of machine learning, signal processing, computational imaging, and embedded hardware—translating research into robust tools for healthcare, agriculture, and environmental monitoring.</p>
        <div class="actions">
          <a class="btn" href={url('/publications')}>Explore publications</a>
          <a class="btn btn-outline" href={url('/Senith_CV_2026.pdf')} target="_blank">Download CV</a>
        </div>
      </div>
      <div class="portrait" aria-label="Senith Jayakody monogram">SJ</div>
    </section>

    <div class="facts">
      <div class="fact"><strong>5 publications</strong><span>Biomedical AI, imaging, and generative audio</span></div>
      <div class="fact"><strong>3.85 GPA</strong><span>B.Sc. Eng. (Hons.), University of Peradeniya</span></div>
      <div class="fact"><strong>2 national awards</strong><span>Manamperi Award and Sahasak Nimavum</span></div>
    </div>

    <section class="section">
      <span class="eyebrow">Research focus</span>
      <h2>Engineering reliable AI from signal to system</h2>
      <div class="cards">
        <article class="card"><small>Biomedical AI</small><h3>Preterm birth prediction</h3><p>Interpretable prediction from uterine electrophysiological signals, with dedicated acquisition hardware for clinically useful datasets.</p></article>
        <article class="card"><small>Computational imaging</small><h3>Multispectral sensing</h3><p>Field-deployable imaging and machine-learning pipelines for soil composition, moisture, and environmental monitoring.</p></article>
        <article class="card"><small>Edge intelligence</small><h3>Embedded sensing systems</h3><p>Hardware–software co-design using Raspberry Pi, ESP32, NRF5340, sensor integration, calibration, and real-time signal processing.</p></article>
      </div>
    </section>

    <section class="section">
      <span class="eyebrow">Currently</span>
      <h2>Research at MARC</h2>
      <p>Leading work on spectrotemporal features and robust models for preterm birth prediction; developing biomedical acquisition hardware; supervising multispectral imaging research; and improving a commercially scalable, field-deployable MSI platform.</p>
      <div class="connect">
        {SOCIAL_LINKS.map(link => <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'}>{link.label} ↗</a>)}
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
