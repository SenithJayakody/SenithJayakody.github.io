---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';
import { url } from '../utils/paths';
const scholar = SOCIAL_LINKS.find((link) => link.label === 'Google Scholar');
const github = SOCIAL_LINKS.find((link) => link.label === 'GitHub');
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
    .hero{align-items:center;display:grid;gap:clamp(2rem,6vw,4.5rem);grid-template-columns:minmax(0,1fr) minmax(220px,300px);padding:3.75rem 0 2.5rem}
    .hero>div{min-width:0}
    .hero h1{font-size:clamp(3.25rem,7vw,5.25rem);letter-spacing:-.055em;line-height:.95;margin:0 0 1rem}
    .academic-id{color:var(--color-accent);font-size:1rem;font-weight:700;letter-spacing:.015em;margin:0 0 1.15rem}
    .bio{font-size:1rem;line-height:1.7;margin:.55rem 0;max-width:690px;overflow-wrap:anywhere}
    .bio a{color:var(--color-text-main);font-weight:600;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--color-accent) 45%,transparent);text-underline-offset:.16em}
    .bio a:hover,.bio a:focus-visible{color:var(--color-accent);text-decoration-color:currentColor}
    .actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.4rem}.actions .btn{font-size:.86rem;padding:.55rem .85rem}
    .portrait{aspect-ratio:1;background:var(--color-bg-offset);border:1px solid var(--color-border);border-radius:22px;overflow:hidden;position:relative}
    .portrait img{height:100%;object-fit:cover;width:100%}
    @media(max-width:760px){.hero{grid-template-columns:minmax(0,1fr);padding:2.6rem 0 2rem}.hero h1{font-size:clamp(3rem,16vw,4rem)}.portrait{max-width:230px}}
  </style>
</head>
<body>
  <Header />
  <main>
    <section class="hero">
      <div>
        <h1>Senith<br />Jayakody</h1>
        <p class="academic-id">Electrical and Electronic Engineering Graduate · University of Peradeniya</p>
        <p class="bio">I currently work as an AI Research and Development Engineer at <a href="https://farbetechnologies.ai/" target="_blank" rel="noopener noreferrer">FARBE Technologies</a>. Previously, I was a Research Assistant at <a href="https://pdnmarc.github.io/" target="_blank" rel="noopener noreferrer">the Multidisciplinary AI Research Centre (MARC)</a>, University of Peradeniya, working with <a href="https://eng.pdn.ac.lk/deee/index.php/people/RoshanG" target="_blank" rel="noopener noreferrer">Prof. Roshan Godaliyadda</a>, <a href="https://eng.pdn.ac.lk/deee/people/ParakramaE" target="_blank" rel="noopener noreferrer">Prof. Parakrama Ekanayake</a>, and <a href="https://eng.pdn.ac.lk/deee/people/VijithaH" target="_blank" rel="noopener noreferrer">Prof. Vijitha Herath</a>.</p>
        <p class="bio">My research interests include signal processing, statistical learning, machine learning, computational imaging, and generative modeling. My research experience spans electrohysterography signal analysis, multispectral imaging, diffusion models, and implicit neural representations, with an emphasis on rigorous evaluation and methods grounded in real-world data.</p>
        <nav class="actions" aria-label="Profile resources">
          <a class="btn" href={url('/resume.pdf')} target="_blank" rel="noopener noreferrer">Download CV</a>
          {scholar && <a class="btn btn-outline" href={scholar.href} target="_blank" rel="noopener noreferrer">Google Scholar</a>}
          {github && <a class="btn btn-outline" href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>}
          {SOCIAL_LINKS.filter(({ label }) => label === 'LinkedIn' || label === 'Email').sort((a,b) => b.label.localeCompare(a.label)).map(({ label, href }) => <a class="btn btn-outline" href={href} target={label === 'Email' ? undefined : '_blank'} rel={label === 'Email' ? undefined : 'noopener noreferrer'}>{label}</a>)}
        </nav>
      </div>
      <div class="portrait">
        <img src={url('/profile.png')} alt="Portrait of Senith Jayakody" width="800" height="800" />
      </div>
    </section>

  </main>
  <Footer />
</body>
</html>
