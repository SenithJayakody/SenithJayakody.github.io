---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects-portfolio.json';
import { url } from '../utils/paths';

const projects = projectsData;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="Research Projects" />
		<style>
			.projects-section {
				max-width: var(--max-width);
				margin: 0 auto;
			}
			.projects-hero {
				text-align: center;
				margin-bottom: 4rem;
				padding: 2rem 0;
			}
			.projects-hero h1 {
				font-family: var(--font-serif);
				font-size: 3.2rem;
				margin: 0 0 1rem 0;
				color: var(--color-text-main);
				letter-spacing: -0.02em;
				line-height: 1.2;
			}
			.projects-hero p {
				font-size: 1.15rem;
				color: var(--color-text-muted);
				max-width: 700px;
				margin: 0 auto;
				line-height: 1.7;
			}
			.projects-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
				gap: 2.5rem;
				margin-bottom: 4rem;
			}
			.project-card {
				display: flex;
				flex-direction: column;
				background-color: var(--color-bg-offset);
				border: 1px solid var(--color-border);
				border-radius: 16px;
				overflow: hidden;
				transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
			}
			.project-card:hover {
				transform: translateY(-6px);
				box-shadow: var(--shadow-lg);
				border-color: var(--color-accent);
			}
			.project-image {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
			}
			.project-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s ease;
			}
			.project-card:hover .project-image img {
				transform: scale(1.05);
			}
			.project-badge {
				position: absolute;
				top: 1rem;
				right: 1rem;
				padding: 0.35rem 0.8rem;
				background-color: var(--color-bg-header);
				color: var(--color-text-main);
				font-size: 0.7rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				border-radius: 20px;
				backdrop-filter: blur(8px);
				box-shadow: 0 2px 8px rgba(0,0,0,0.1);
				z-index: 10;
			}
			.project-content-wrapper {
				display: flex;
				flex-direction: column;
				padding: 1.75rem;
				flex: 1;
			}
			.project-category {
				color: var(--color-accent);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				line-height: 1.4;
				margin-bottom: 0.55rem;
				text-transform: uppercase;
			}
			.project-year {
				font-size: 0.75rem;
				color: var(--color-accent);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.5rem;
			}
			.project-card h3 {
				font-family: var(--font-serif);
				font-size: 1.4rem;
				margin: 0 0 1rem 0;
				line-height: 1.3;
				color: var(--color-text-main);
			}
			.project-card h3 a {
				color: inherit;
				text-decoration: none;
			}
			.project-description {
				color: var(--color-text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
				margin-bottom: 1.5rem;
			}
			.project-highlights {
				color: var(--color-text-muted);
				font-size: 0.88rem;
				line-height: 1.5;
				margin: 0 0 1.25rem;
				padding-left: 1.1rem;
			}
			.project-highlights li + li { margin-top: 0.35rem; }
			.project-output {
				border-left: 3px solid var(--color-accent);
				margin: 0;
				padding: 0.15rem 0 0.15rem 0.85rem;
			}
			.project-outputs {
				display: grid;
				gap: 0.85rem;
				margin: auto 0 1.25rem;
			}
			.output-label {
				color: var(--color-accent);
				display: block;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				margin-bottom: 0.25rem;
				text-transform: uppercase;
			}
			.output-title {
				color: var(--color-text-main);
				font-size: 0.88rem;
				line-height: 1.45;
			}
			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-bottom: 1.25rem;
			}
			.project-tag {
				background: color-mix(in srgb, var(--color-accent) 10%, transparent);
				border: 1px solid color-mix(in srgb, var(--color-accent) 22%, var(--color-border));
				border-radius: 999px;
				color: var(--color-text-muted);
				font-size: 0.72rem;
				padding: 0.3rem 0.6rem;
			}
			.project-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
			}
			.project-action {
				align-items: center;
				border: 1px solid var(--color-border);
				border-radius: 999px;
				color: var(--color-accent);
				display: inline-flex;
				font-size: 0.82rem;
				font-weight: 700;
				gap: 0.3rem;
				padding: 0.45rem 0.75rem;
				text-decoration: none;
				transition: border-color 0.2s ease, background-color 0.2s ease;
			}
			.project-action:hover {
				background: color-mix(in srgb, var(--color-accent) 9%, transparent);
				border-color: var(--color-accent);
			}
			.action-note {
				color: var(--color-text-muted);
				font-size: 0.72rem;
				font-weight: 400;
			}
			.project-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				margin-bottom: 1.25rem;
				flex-wrap: wrap;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
			}
			.meta-label {
				font-weight: 600;
				color: var(--color-text-muted);
			}
			.author-names {
				color: var(--color-text-main);
				font-weight: 500;
			}
			.read-more {
				display: inline-flex;
				align-items: center;
				font-size: 0.9rem;
				color: var(--color-accent);
				text-decoration: none;
				font-weight: 600;
				transition: gap 0.2s ease;
				gap: 0.25rem;
			}
			.read-more:hover {
				gap: 0.5rem;
			}
			@media (max-width: 768px) {
				.projects-hero h1 { font-size: 2.5rem; }
				.projects-grid { gap: 2rem; }
				.project-content-wrapper { padding: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="projects-section">
			<div class="projects-hero">
				<h1>Research Projects</h1>
				<p>Research spanning signal processing, machine learning, generative modeling, computational imaging, and interdisciplinary applications.</p>
			</div>
			
			<div class="projects-grid">
				{projects.length > 0 ? projects.map((project) => (
					<article class="project-card">
						<div class="project-image">
							<img src={url(project.image)} alt={project.imageAlt} width="1536" height="864" loading="lazy" decoding="async" />
							<span class="project-badge">{project.status}</span>
						</div>

						<div class="project-content-wrapper">
							<div class="project-header">
								<div class="project-category">{project.category}</div>
								<span class="project-year">{project.period}</span>
								<h3>{project.title}</h3>
							</div>
							
							<p class="project-description">{project.description}</p>

							<ul class="project-highlights">
								{project.highlights.map((highlight) => <li>{highlight}</li>)}
							</ul>

							<div class="project-tags" aria-label="Research topics">
								{project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
							</div>

							{(project.outputs ?? (project.output ? [project.output] : [])).length > 0 && (
								<div class="project-outputs">
									{(project.outputs ?? (project.output ? [project.output] : [])).map((output) => (
										<div class="project-output">
											<span class="output-label">{output.label}</span>
											<div class="output-title">{output.title}</div>
										</div>
									))}
								</div>
							)}

							{project.actions && project.actions.length > 0 && (
								<div class="project-actions">
									{project.actions.map((action) => (
										<a href={action.url} target="_blank" rel="noopener noreferrer" class="project-action">
											{action.label} <span aria-hidden="true">↗</span>
											{action.note && <span class="action-note">({action.note})</span>}
										</a>
									))}
								</div>
							)}
						</div>
					</article>
				)) : (
                    <p>No projects found in <code>src/data/projects.json</code>.</p>
                )}
			</div>
		</main>
		<Footer />
	</body>
</html>
