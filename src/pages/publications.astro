---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import AuthorLink from '../components/AuthorLink.astro';
import bibFileRaw from '../data/publications.bib?raw';

interface Author {
    first: string;
    last: string;
}

interface BibEntry {
    type: string;
    key: string;
    fields: Record<string, string>;
    authors: Author[];
}

function parseBibTeX(input: string): BibEntry[] {
    const entries: BibEntry[] = [];
    const rawEntries = input.split(/@(\w+)\s*\{/g).slice(1);

    for (let i = 0; i < rawEntries.length; i += 2) {
        const type = rawEntries[i].trim();
        const body = rawEntries[i+1];
        if (!body) continue;

        const keyMatch = body.match(/^\s*([^,]+),/);
        const key = keyMatch ? keyMatch[1].trim() : 'unknown';
        
        const fields: Record<string, string> = { title: "Untitled", year: "0000" };
        
        const fieldRegex = /(\w+)\s*=\s*(?:\{((?:[^{}]|{[^{}]*})*)\}|"((?:[^"]|\\")*)"|(\d+))/g;
        
        let match;
        while ((match = fieldRegex.exec(body)) !== null) {
            const fieldKey = match[1].toLowerCase();
            const val = match[2] || match[3] || match[4] || "";
            fields[fieldKey] = val.replace(/\s+/g, ' ').trim();
        }

        let authors: Author[] = [];
        if (fields.author) {
            authors = fields.author.split(/\s+and\s+/i).map(str => {
                const parts = str.split(',');
                if (parts.length > 1) {
                    return { first: parts[1].trim(), last: parts[0].trim() };
                } else {
                    const names = str.trim().split(' ');
                    const last = names.pop() || "";
                    const first = names.join(' ');
                    return { first, last };
                }
            });
        }

        entries.push({ type, key, fields, authors });
    }
    return entries;
}

const sortEntries = (entries: BibEntry[]) => entries.sort((a, b) => {
    const yearDifference = (parseInt(b.fields.year) || 0) - (parseInt(a.fields.year) || 0);
    if (yearDifference !== 0) return yearDifference;
    return (parseInt(a.fields.order) || 99) - (parseInt(b.fields.order) || 99);
});

const publications = parseBibTeX(bibFileRaw);
const sections = [
    { title: 'Peer-Reviewed Publications', entries: sortEntries(publications.filter((entry) => entry.fields.category === 'peer-reviewed')) },
    { title: 'Manuscripts Under Review', entries: sortEntries(publications.filter((entry) => entry.fields.category === 'under-review')) },
    { title: 'Preprints', entries: sortEntries(publications.filter((entry) => entry.fields.category === 'preprint')) },
];

const formatAuthor = (author: Author) => author.first ? `${author.first} ${author.last}` : author.last;
const clean = (value = '') => value.replace(/[{}]/g, '');
const normalizeName = (value = '') => value.toLowerCase().replace(/[^a-z0-9]/g, '');
const isCurrentAuthor = (author: Author) => {
    if (normalizeName(author.last) !== 'jayakody') return false;
    return ['senith', 's', 'jast'].includes(normalizeName(author.first));
};
const equalContributionIndexes = (entry: BibEntry) => new Set(
    (entry.fields.equalcontribution || '')
        .split(',')
        .map((value) => parseInt(value.trim()))
        .filter((value) => Number.isInteger(value))
);

const bibFieldOrder = ['title', 'author', 'journal', 'booktitle', 'pages', 'year', 'doi', 'eprint', 'archiveprefix', 'primaryclass', 'note'];
const createBibTeX = (entry: BibEntry) => {
    const fields = bibFieldOrder
        .filter((field) => entry.fields[field])
        .map((field) => `  ${field}={${entry.fields[field]}}`)
        .join(',\n');
    return `@${entry.type}{${entry.key},\n${fields}\n}`;
};

const venueFor = (entry: BibEntry) => {
    if (entry.fields.status) return entry.fields.status;
    return clean(entry.fields.journal || entry.fields.booktitle || 'Preprint');
};

const noteFor = (entry: BibEntry) => {
    if (entry.fields.contributionnote) return '';
    const note = entry.fields.note || '';
    const statusPrefix = entry.fields.status ? `${entry.fields.status}. ` : '';
    return statusPrefix && note.startsWith(statusPrefix) ? note.slice(statusPrefix.length) : note;
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Publications | ${SITE_TITLE}`} description="Academic Publications" />
		<style>
			.publication-section { margin-top: 2.75rem; }
			.publication-section h2 { margin: 0 0 1.5rem; }
			.publication-item { position: relative; }
			.pub-links { display: flex; align-items: center; flex-wrap: wrap; gap: .65rem; margin-top: .65rem; font-size: .85rem; }
			.pub-links a, .pub-links summary { font-weight: 600; }
			.pub-links a { display: inline-flex; align-items: center; }
			.pub-note { margin: .45rem 0 0; font-size: .86rem; color: var(--color-text-muted); }
			.self-author { font-weight: 700; text-decoration: underline; text-underline-offset: .16em; text-decoration-thickness: .08em; }
			.equal-contribution-marker { margin-left: .08em; font-size: .72em; line-height: 0; }
			.contribution-note { margin: .35rem 0 0; font-size: .82rem; color: var(--color-text-muted); }
			.bibtex-details { position: relative; }
			.bibtex-details summary { cursor: pointer; color: var(--color-accent); list-style: none; }
			.bibtex-details summary::-webkit-details-marker { display: none; }
			.bibtex-panel { position: absolute; left: 0; top: calc(100% + .5rem); background: var(--color-bg-offset); border: 1px solid var(--color-border); color: var(--color-text-main); padding: .75rem; box-shadow: var(--shadow-lg); border-radius: 8px; z-index: 10; width: min(420px, calc(100vw - 2rem)); max-height: 280px; overflow: auto; }
			.bibtex-toolbar { display: flex; justify-content: flex-end; margin-bottom: .5rem; }
			.copy-bibtex-btn { background: none; border: none; cursor: pointer; color: var(--color-text-muted); font: inherit; font-size: .75rem; display: flex; align-items: center; gap: 4px; padding: 0; }
			.bibtex-panel pre { margin: 0; font-size: .72rem; white-space: pre-wrap; word-break: break-word; }
			@media (max-width: 720px) {
				.publication-section { margin-top: 2.25rem; }
				.publication-section h2 { font-size: 1.55rem; }
				.bibtex-panel { position: fixed; left: 1rem; right: 1rem; top: 20%; width: auto; max-height: 60vh; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Publications</h1>

			{sections.map((section) => (
				<section class="publication-section">
					<h2>{section.title}</h2>
					<div class="publication-list">
						{section.entries.map((entry) => {
							const bibtex = createBibTeX(entry);
							const equalContributors = equalContributionIndexes(entry);
							return (
								<article class="publication-item">
									<span class="pub-title">{clean(entry.fields.title)}</span>
									<div class="pub-authors">
										{entry.authors.map((author, index) => {
											const displayName = formatAuthor(author);
											return (
												<>
													{isCurrentAuthor(author) ? (
														<span class="self-author">{displayName}</span>
													) : (
														<AuthorLink nameOrSlug={displayName} />
													)}
													{equalContributors.has(index) && <sup class="equal-contribution-marker" aria-label="equal contribution">†</sup>}
													{index < entry.authors.length - 1 ? ', ' : ''}
												</>
											);
										})}
									</div>
									{entry.fields.contributionnote && <p class="contribution-note">† {entry.fields.contributionnote}.</p>}
									<div class="pub-venue">
										{venueFor(entry)}
										{entry.fields.pages && <span>, pp. {entry.fields.pages.replace('--', '–')}</span>}
										{entry.fields.year && <span> ({entry.fields.year})</span>}
									</div>
									{noteFor(entry) && noteFor(entry) !== entry.fields.status && <p class="pub-note">{noteFor(entry)}</p>}
									<div class="pub-links">
										{entry.fields.paper && <a href={entry.fields.paper} target="_blank" rel="noopener noreferrer">Paper</a>}
										{entry.fields.doi && <a href={`https://doi.org/${entry.fields.doi}`} target="_blank" rel="noopener noreferrer">DOI</a>}
										{entry.fields.arxiv && <a href={entry.fields.arxiv} target="_blank" rel="noopener noreferrer">arXiv</a>}
										{entry.fields.code && <a href={entry.fields.code} target="_blank" rel="noopener noreferrer">Code</a>}
										<details name="bibtex" class="bibtex-details">
											<summary>BibTeX</summary>
											<div class="bibtex-panel">
												<div class="bibtex-toolbar">
													<button class="copy-bibtex-btn" data-bibtex={bibtex}>
														<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
														<span class="copy-text">Copy</span>
													</button>
												</div>
												<pre>{bibtex}</pre>
											</div>
										</details>
									</div>
								</article>
							);
						})}
					</div>
				</section>
			))}
		</main>
		<Footer />

		<script>
            // Ensure only one BibTeX panel is open at a time (fallback for browsers without 'name' attr support)
			const detailsElements = document.querySelectorAll('details[name="bibtex"]');
			detailsElements.forEach(details => {
				details.addEventListener('toggle', () => {
					if (details.hasAttribute('open')) {
						detailsElements.forEach(other => {
							if (other !== details && other.hasAttribute('open')) {
								other.removeAttribute('open');
							}
						});
					}
				});
			});

            // Copy to clipboard functionality
			const copyBtns = document.querySelectorAll('.copy-bibtex-btn');
			copyBtns.forEach(btn => {
				btn.addEventListener('click', async (e) => {
					e.preventDefault(); // prevent details from toggling if button triggers
					const bibtex = btn.getAttribute('data-bibtex');
					const textSpan = btn.querySelector('.copy-text');
					if (bibtex && textSpan) {
						try {
							await navigator.clipboard.writeText(bibtex);
							textSpan.textContent = 'Copied!';
                            btn.setAttribute('style', 'background: none; border: none; cursor: pointer; color: var(--color-accent); font-size: 0.75rem; display: flex; align-items: center; gap: 4px; padding: 0;');
							setTimeout(() => {
								textSpan.textContent = 'Copy';
                                btn.setAttribute('style', 'background: none; border: none; cursor: pointer; color: var(--color-text-muted); font-size: 0.75rem; display: flex; align-items: center; gap: 4px; padding: 0;');
							}, 2000);
						} catch (err) {
							console.error('Failed to copy', err);
						}
					}
				});
			});
		</script>
	</body>
</html>
